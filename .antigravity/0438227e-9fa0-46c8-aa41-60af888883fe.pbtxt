        replacement_content: "body {\n  background-color: var(--bg-body);\n  color: var(--text-primary);\n  font-family: var(--font-sans);\n  transition: background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n  overflow-x: hidden;\n  position: relative;\n}\n\n/* --- AMBIENT MESH BACKGROUND --- */\nbody::before {\n  content: \"\";\n  position: fixed;\n  top: -15%;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 1400px;\n  height: 600px;\n  background: radial-gradient(circle, rgba(59, 130, 246, 0.06) 0%, rgba(139, 92, 246, 0.03) 35%, transparent 70%);\n  z-index: 0;\n  pointer-events: none;\n}\n\nhtml.light body::before {\n  background: radial-gradient(circle, rgba(59, 130, 246, 0.03) 0%, rgba(139, 92, 246, 0.01) 35%, transparent 70%);\n}"
