      target_content: "/* --- DYNAMIC TRANSITIONS --- */\n.animate-fade-in-up {\n  animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n@keyframes fadeInUp {\n  0% {\n    opacity: 0;\n    transform: translateY(24px);\n  }\n  100% {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}"
      replacement_content: "/* --- DYNAMIC TRANSITIONS --- */\n.animate-fade-in-up {\n  animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n@keyframes fadeInUp {\n  0% {\n    opacity: 0;\n    transform: translateY(24px);\n  }\n  100% {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* --- DRAG OVER PULSING FEEDBACK --- */\n.drag-over-active {\n  border-color: #3b82f6 !important;\n  background: rgba(59, 130, 246, 0.08) !important;\n  box-shadow: 0 0 0 6px rgba(59, 130, 246, 0.15) !important;\n  transform: scale(1.02);\n}\n\n/* --- SWEETALERT CUSTOM STYLING --- */\n.swal2-container {\n  backdrop-filter: blur(12px) !important;\n  -webkit-backdrop-filter: blur(12px) !important;\n  z-index: 99999 !important;\n}\n\n.swal2-popup {\n  background: var(--card-bg) !important;\n  border: 1px solid var(--glass-border) !important;\n  border-radius: 2rem !important;\n  color: var(--text-primary) !important;\n  font-family: \"Outfit\", \"Inter\", sans-serif !important;\n  padding: 2.5rem 1.5rem !important;\n}\n\n.swal2-title {\n  color: var(--text-primary) !important;\n  font-family: var(--font-sans) !important;\n  font-weight: 700 !important;\n  letter-spacing: -0.025em !important;\n}\n\n.swal2-html-container {\n  color: var(--text-secondary) !important;\n  font-family: var(--font-sans) !important;\n}\n\n.swal2-actions {\n  gap: 12px;\n  margin-top: 2rem !important;\n}\n\n.swal2-styled.swal2-confirm {\n  background: linear-gradient(135deg, #2563eb, #4f46e5) !important;\n  border-radius: 12px !important;\n  font-weight: 600 !important;\n  font-size: 0.875rem !important;\n  padding: 12px 28px !important;\n  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2) !important;\n  transition: all 0.2s ease !important;\n}\n\n.swal2-styled.swal2-confirm:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 6px 16px rgba(37, 99, 235, 0.3) !important;\n}\n\n.swal2-styled.swal2-deny, .swal2-styled.swal2-cancel {\n  background: var(--input-bg) !important;\n  border: 1px solid var(--glass-border) !important;\n  border-radius: 12px !important;\n  color: var(--text-primary) !important;\n  font-weight: 600 !important;\n  font-size: 0.875rem !important;\n  padding: 12px 28px !important;\n  transition: all 0.2s ease !important;\n}\n\n.swal2-loader {\n  border-color: #3b82f6 transparent #3b82f6 transparent !important;\n}\n\n.swal2-icon.swal2-success {\n  border-color: #10b981 !important;\n  color: #10b981 !important;\n}\n\n.swal2-icon.swal2-success [class^=\'swal2-success-line\'] {\n  background-color: #10b981 !important;\n}\n\n.swal2-icon.swal2-success .swal2-success-ring {\n  border: 4px solid rgba(16, 185, 129, 0.2) !important;\n}"
    }
