      replacement_content: "            <div class=\"flex items-center gap-4 cursor-pointer group\" id=\"logo-branding\">\n                <svg width=\"32\" height=\"32\" viewBox=\"0 0 100 100\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"group-hover:rotate-12 transition-transform duration-300 drop-shadow-lg opacity-95\">\n                    <path d=\"M50 10V0C50 0 42 0 40 8C38 14 30 18 22 14C14 10 8 16 8 16L4 24C4 24 10 28 8 36C6 44 0 46 0 46V54C0 54 6 56 8 64C10 72 4 76 4 76L8 84C8 84 14 80 22 84C30 88 38 92 40 98C42 106 50 106 50 106V96C50 96 50 96 50 96V10Z\" fill=\"#1e293b\"/>\n                    <path d=\"M50 0C77.6142 0 100 22.3858 100 50C100 77.6142 77.6142 100 50 100V0Z\" fill=\"#3b82f6\"/>\n                    <path d=\"M50 25C50 25 75 30 93 30\" stroke=\"white\" stroke-width=\"2\" stroke-opacity=\"0.8\"/>\n                    <path d=\"M50 50H100\" stroke=\"white\" stroke-width=\"2\" stroke-opacity=\"0.8\"/>\n                    <path d=\"M50 75C50 75 75 70 93 70\" stroke=\"white\" stroke-width=\"2\" stroke-opacity=\"0.8\"/>\n                    <path d=\"M75 7C75 7 70 25 70 50C70 75 75 93 75 93\" stroke=\"white\" stroke-width=\"2\" stroke-opacity=\"0.8\"/>\n                    <path d=\"M35 30C32 30 30 32 30 35V45L38 55V35C38 32 36 30 35 30Z\" fill=\"#1e293b\"/>\n                    <path d=\"M40 65H60V80H40V65Z\" fill=\"#1e293b\"/>\n                    <rect x=\"48\" y=\"65\" width=\"4\" height=\"3\" fill=\"#fbbf24\"/> \n                    <path d=\"M45 65V62C45 60 55 60 55 62V65\" stroke=\"#1e293b\" stroke-width=\"2\" fill=\"none\"/>\n                    <path d=\"M30 80L70 20L50 50L30 80Z\" fill=\"#facc15\" stroke=\"#b45309\" stroke-width=\"1\"/>\n                    <path d=\"M30 80L50 50\" fill=\"#fef08a\"/>\n                    <circle cx=\"50\" cy=\"50\" r=\"4\" fill=\"white\" stroke=\"#b45309\" stroke-width=\"2\"/>\n                </svg>\n                <div class=\"flex flex-col\">\n                    <span class=\"font-serif italic text-2xl text-white tracking-tight leading-none\">HemiToolkit</span>\n                    <span class=\"text-[9px] text-zinc-500 uppercase tracking-[0.25em] mt-1 leading-none font-mono\">Developer Utility Suite</span>\n                </div>\n            </div>\n\n            <div class=\"flex items-center gap-4\">\n                <div class=\"hidden md:flex relative group\">\n                    <input type=\"text\" id=\"global-search\" placeholder=\"Search for a tool...\" \n                           class=\"glass-input pl-10 pr-16 py-2 rounded-full text-sm w-72 focus:w-80 transition-all font-sans bg-white/5 border border-white/10 text-white placeholder-zinc-500\">\n                    <i class=\"fa-solid fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-500\"></i>\n                    <span class=\"absolute right-4 top-1/2 -translate-y-1/2 text-[9px] text-zinc-600 font-mono border border-white/10 px-1.5 py-0.5 rounded leading-none select-none\">/</span>\n                </div>\n                <button id=\"theme-btn\" class=\"w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white transition-colors cursor-pointer\">\n                    <i class=\"fa-solid fa-moon\"></i>\n                </button>\n            </div>"
